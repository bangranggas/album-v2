# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored; this example file is not.

# --- Database (Turso / libSQL) ---
# Local development & tests use a plain file. Production uses the Turso URL.
# Local:  TURSO_DATABASE_URL="file:./local.db"
# Turso:  TURSO_DATABASE_URL="libsql://<db>-<org>.turso.io"
TURSO_DATABASE_URL="file:./local.db"

# Only required when TURSO_DATABASE_URL points at Turso. Leave empty for local files.
TURSO_AUTH_TOKEN=""

# --- Auth ---
# Shared between the Tampermonkey userscript and POST/GET /api/links.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=""

# Password for the dashboard at `/`. The login page asks for this one value only:
# there is no username field and no browser popup.
# Any non-blank value works — there is no minimum length. Keep it blank and the
# dashboard returns 503; a long random value is still the safest choice.
DASHBOARD_PASSWORD=""

# Passcode for the hidden area at `/locked`, where domains can be marked as hidden.
# Any non-blank value works, the same as the dashboard password.
# If unset or blank, only `/locked` returns 503; the rest keeps working.
LOCKED_PASSCODE=""
